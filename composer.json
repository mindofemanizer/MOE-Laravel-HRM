{
    "name": "moe/laravel-hrm",
    "description": "HRM module for MOE ecosystem — Employee, Attendance, Payroll",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "emanizer@example.com"
        }
    ],
    "keywords": ["laravel", "hrm", "employee", "attendance", "payroll", "moe"],
    "autoload": {
        "psr-4": {
            "Moe\\HRM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\HRM\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "moe/laravel-core": "*",
        "moe/laravel-finance": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\HRM\\HRMServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
